{
  "name": "minecodex",
  "version": "2.0.32",
  "description": "Lightweight, local-first plugins for the Codex desktop app.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcx": "packages/cli/bin/mcx.mjs"
  },
  "workspaces": [
    "packages/*",
    "features/*",
    "apps/*"
  ],
  "files": [
    "LICENSE",
    "packages/cli/bin",
    "packages/cli/src",
    "packages/cli/native/MineCodex.app",
    "packages/runtime-host/src",
    "features/model-slider/src",
    "features/model-slider/assets",
    "features/model-slider/codex-feature.json",
    "features/model-slider/THIRD_PARTY_NOTICES.md",
    "features/model-slider/vendor",
    "features/notes/src",
    "features/notes/assets",
    "features/notes/vendor/phosphor-LICENSE",
    "features/notes/codex-feature.json",
    "features/images/src",
    "features/images/web",
    "features/images/codex-feature.json",
    "features/hide-upsell-banner/src",
    "features/hide-upsell-banner/codex-feature.json",
    "features/session-status/src",
    "features/session-status/codex-feature.json",
    "features/session-status/vendor/lucide-LICENSE",
    "features/session-status/vendor/phosphor-LICENSE",
    "apps/dashboard/app.js",
    "apps/dashboard/assets",
    "apps/dashboard/favicon.svg",
    "apps/dashboard/index.html",
    "apps/dashboard/styles.css",
    "README.md",
    "features/usage-meter/src",
    "features/usage-meter/codex-feature.json",
    "features/quick-chat/src",
    "features/quick-chat/assets",
    "features/quick-chat/vendor/lucide-LICENSE",
    "features/quick-chat/codex-feature.json",
    "features/sidebar-focus/src",
    "features/sidebar-focus/codex-feature.json",
    "features/sidebar-focus/vendor/lucide-LICENSE",
    "features/sites/src",
    "features/sites/codex-feature.json",
    "features/sites/vendor/lucide-LICENSE",
    "packages/ui/src",
    "packages/codex-adapter/src",
    "packages/codex-adapter/package.json",
    "packages/ui/package.json",
    "assets/brand/minecodex-icon.svg",
    "assets/brand/minecodex-icon-light.svg",
    "assets/brand/minecodex-icon-dark.svg",
    "assets/brand/minecodex-icon-selected.svg",
    "assets/brand/references/lucide-LICENSE.txt",
    "assets/readme/hero.svg",
    "packages/ui/assets",
    "features/markdown-reading/src",
    "features/markdown-reading/codex-feature.json",
    "features/markdown-reading/vendor/lucide-LICENSE",
    "features/markdown-reading/assets",
    "features/file-navigation/src",
    "features/file-navigation/codex-feature.json",
    "features/file-navigation/assets",
    "features/file-navigation/vendor/lucide-LICENSE",
    "apps/dashboard/transport.js",
    "packages/plugin/src",
    "packages/plugin/assets",
    "packages/plugin/plugin.json"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node packages/cli/bin/mcx.mjs serve",
    "test": "node --test packages/cli/test/*.test.mjs packages/runtime-host/test/*.test.mjs features/model-slider/test/*.test.mjs features/notes/test/*.test.mjs features/images/test/*.test.mjs features/hide-upsell-banner/test/*.test.mjs features/session-status/test/*.test.mjs features/usage-meter/test/*.test.mjs apps/dashboard/test/*.test.mjs features/unread-inbox/test/*.test.mjs features/quick-chat/test/*.test.mjs features/sidebar-focus/test/*.test.mjs features/sites/test/*.test.mjs packages/ui/test/*.test.mjs packages/codex-adapter/test/*.test.mjs features/markdown-reading/test/*.test.mjs features/file-navigation/test/*.test.mjs packages/plugin/test/*.test.mjs",
    "test:cli": "node --test packages/cli/test/*.test.mjs",
    "test:runtime": "node --test packages/runtime-host/test/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "build:service": "scripts/build-service-app.zsh",
    "pack:check": "npm pack --dry-run",
    "pack:audit": "node scripts/audit-package.mjs",
    "prepublishOnly": "npm test && npm run check && npm run pack:audit",
    "test:ui": "node --test packages/ui/test/*.test.mjs",
    "build:icons": "node scripts/build-brand-icons.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "test:plugin": "node --test packages/plugin/test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vontean/MineCodex.git"
  },
  "bugs": {
    "url": "https://github.com/Vontean/MineCodex/issues"
  },
  "homepage": "https://github.com/Vontean/MineCodex#readme",
  "keywords": [
    "codex",
    "minecodex",
    "macos",
    "windows",
    "plugins"
  ],
  "os": [
    "darwin",
    "win32"
  ],
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "acorn": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
