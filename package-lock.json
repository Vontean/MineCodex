{
  "name": "minecodex",
  "version": "0.1.10",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "minecodex",
      "version": "0.1.10",
      "license": "MIT",
      "os": [
        "darwin"
      ],
      "workspaces": [
        "packages/*",
        "features/*",
        "apps/*"
      ],
      "bin": {
        "mcx": "packages/cli/bin/mcx.mjs"
      },
      "engines": {
        "node": ">=22.5.0"
      }
    },
    "features/images": {
      "name": "@minecodex/images",
      "version": "0.1.10",
      "engines": {
        "node": ">=22.5.0"
      }
    },
    "features/model-slider": {
      "name": "@minecodex/model-slider",
      "version": "0.1.10"
    },
    "features/notes": {
      "name": "@minecodex/notes",
      "version": "0.1.10",
      "engines": {
        "node": ">=22.5.0"
      }
    },
    "node_modules/@minecodex/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@minecodex/images": {
      "resolved": "features/images",
      "link": true
    },
    "node_modules/@minecodex/model-slider": {
      "resolved": "features/model-slider",
      "link": true
    },
    "node_modules/@minecodex/notes": {
      "resolved": "features/notes",
      "link": true
    },
    "node_modules/@minecodex/runtime-host": {
      "resolved": "packages/runtime-host",
      "link": true
    },
    "packages/cli": {
      "name": "@minecodex/cli",
      "version": "0.1.10"
    },
    "packages/runtime-host": {
      "name": "@minecodex/runtime-host",
      "version": "0.1.10",
      "engines": {
        "node": ">=22.5.0"
      }
    }
  }
}
