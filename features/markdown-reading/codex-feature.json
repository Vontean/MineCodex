{
  "schemaVersion": 1,
  "id": "markdown-reading",
  "version": "0.1.0",
  "label": {
    "en": "Markdown Reader",
    "zh-CN": "Markdown 阅读增强"
  },
  "description": {
    "en": "Read Markdown with a chapter outline, expandable tables, and copyable code blocks.",
    "zh-CN": "让 Markdown 文档更易读，支持章节目录、表格展开和代码复制。"
  },
  "entry": {
    "kind": "page-script",
    "script": "src/markdown-reading.mjs",
    "sourceFactory": "src/injection-source.mjs",
    "resources": {
      "styles": "src/reading.css",
      "mermaidStyles": "src/mermaid/theme.css",
      "qvTemplate": "assets/qv-template.json",
      "qvDependencies": "assets/qv-dependencies.js"
    }
  },
  "icon": {
    "resource": "assets/book-open.svg"
  },
  "placement": {
    "order": 90
  }
}
